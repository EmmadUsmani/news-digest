{
  "uid": "nd-public-overview",
  "title": "Published digest overview",
  "description": "Prepared only. Latest 30 publication days in UTC and current aggregate source health; independent of the time picker.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": ["news-digest"],
  "timezone": "utc",
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Published editions by UTC day",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-product-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT day_utc, editions FROM grafana_public.published_editions ORDER BY day_utc DESC LIMIT 30",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "Published content by UTC day",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-product-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT day_utc, topics, stories, posts FROM grafana_public.published_content ORDER BY day_utc DESC LIMIT 30",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "title": "Current source health",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "public-product-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS sources, count(*) FILTER (WHERE enabled) AS enabled, count(*) FILTER (WHERE enabled AND has_error) AS errors FROM grafana_public.source_health",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
