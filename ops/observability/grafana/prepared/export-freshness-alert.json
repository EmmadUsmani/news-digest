{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "public-export",
      "folder": "News Digest",
      "interval": "1m",
      "rules": [
        {
          "uid": "nd-public-export-freshness",
          "title": "Public export is missing or stale",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "public-product-postgres",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "public-product-postgres"
                },
                "format": "table",
                "rawQuery": true,
                "rawSql": "SELECT CASE WHEN max(captured_at) BETWEEN statement_timestamp() - interval '15 minutes' AND statement_timestamp() THEN 0 ELSE 1 END::double precision AS unhealthy FROM grafana_public.export_status",
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": ["B"]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [0]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "5m",
          "annotations": {
            "summary": "Published aggregate export is missing, future-dated, over 15 minutes old, or unreadable."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        }
      ]
    }
  ]
}
