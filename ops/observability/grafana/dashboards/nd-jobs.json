{
  "uid": "nd-jobs",
  "title": "Jobs",
  "description": "Retained counts are snapshots, not lifetime totals. Processor attempts count retries separately and exclude queue wait. No samples means no observed attempts.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": ["news-digest"],
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Retained jobs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "news_digest_queue_jobs",
          "legendFormat": "{{queue}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Recurring schedulers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "news_digest_queue_schedulers",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Paused queues",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "news_digest_queue_paused",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Settled attempts per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, outcome) (rate(news_digest_job_duration_seconds_count[5m]))",
          "legendFormat": "{{queue}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Attempt p95 duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(news_digest_job_duration_seconds_bucket[5m])))",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "links": [
    {
      "title": "Logs",
      "url": "/logs/select/vmui/"
    },
    {
      "title": "Queues",
      "url": "/queues/"
    }
  ]
}
