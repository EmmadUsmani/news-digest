      "title": "Supervisor tasks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "news_digest_unit_tasks{unit=\"news-digest-agent.service\",scope=\"user\"}",
          "legendFormat": "supervisor"
        }
