        }
      }
    },
    {
      "id": 3,
      "title": "Supervisor CPU (one core)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(news_digest_unit_cpu_seconds_total{unit=\"news-digest-agent.service\",scope=\"user\"}[5m])",
          "legendFormat": "supervisor"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
