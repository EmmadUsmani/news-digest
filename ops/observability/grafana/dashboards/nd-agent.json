{
  "uid": "nd-agent",
  "title": "Agent supervisor",
  "description": "Existing systemd cgroup measurements for the build supervisor and its child processes. Active means the unit is running, not that an iteration is progressing. No iteration, token, quota or commit measurements are collected. Snapshot age is shared with all unit metrics.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": ["news-digest"],
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Supervisor active",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "news_digest_unit_active{unit=\"news-digest-agent.service\",scope=\"user\"}",
          "legendFormat": "supervisor"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Supervisor memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "news_digest_unit_memory_bytes{unit=\"news-digest-agent.service\",scope=\"user\"}",
          "legendFormat": "supervisor"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Supervisor CPU (one core)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(news_digest_unit_cpu_seconds_total{unit=\"news-digest-agent.service\",scope=\"user\"}[5m])",
          "legendFormat": "supervisor"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Supervisor tasks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "news_digest_unit_tasks{unit=\"news-digest-agent.service\",scope=\"user\"}",
          "legendFormat": "supervisor"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Supervisor automatic restarts since activation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "news_digest_unit_restarts_total{unit=\"news-digest-agent.service\",scope=\"user\"}",
          "legendFormat": "supervisor"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Unit snapshot age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - news_digest_unit_snapshot_timestamp_seconds",
          "legendFormat": "snapshot"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "links": [
    {
      "title": "Logs",
      "url": "/logs/select/vmui/"
    },
    {
      "title": "Queues",
      "url": "/queues/"
    }
  ]
}
