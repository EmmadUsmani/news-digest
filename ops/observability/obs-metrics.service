[Unit]
Description=VictoriaMetrics host metrics store
Requires=obs-metric-volume.service
After=obs-metric-volume.service
[Service]
User=exedev
ExecStartPre=/usr/bin/mkdir -p /var/lib/news-digest-metrics/data/cache
ExecStartPre=/usr/bin/touch /var/lib/news-digest-metrics/data/cache/reset_cache_on_startup
ExecStart=/opt/news-digest-observability/victoria-metrics-prod -httpListenAddr=127.0.0.1:8428 -http.pathPrefix=/metrics -storageDataPath=/var/lib/news-digest-metrics/data -retentionPeriod=30d -storage.minFreeDiskSpaceBytes=50MB -memory.allowedBytes=16MiB -promscrape.config=/etc/news-digest-observability/scrape.yml -search.maxConcurrentRequests=2 -search.maxMemoryPerQuery=8MiB
Environment=GOMAXPROCS=1 GOMEMLIMIT=64MiB
Restart=always
RestartSec=5
MemoryMax=112M
CPUQuota=1%
CPUWeight=10
IOWeight=10
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/news-digest-metrics
[Install]
WantedBy=multi-user.target
