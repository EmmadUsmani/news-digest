[Unit]
Description=Private news-digest database backup
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/exedev/news-digest/ops/backups/database.py backup
# Offsite failures never turn a completed local dump into a failed backup.
ExecStartPost=-/usr/bin/python3 /home/exedev/news-digest/ops/backups/offsite.py
TimeoutStartSec=20min
Nice=10
UMask=0077
