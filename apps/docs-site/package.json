{
  "name": "@digest/docs-site",
  "private": true,
  "type": "module",
  "description": "Serves docs/handbook (Markdown + Mermaid) as a browsable site. No build step: pages are read from disk per request.",
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test src/*.test.ts",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@digest/tool-metrics": "workspace:*",
    "@mermaid-js/layout-elk": "0.2.0",
    "dompurify": "3.3.0",
    "esbuild": "0.25.12",
    "marked": "15.0.12",
    "mermaid": "11.12.1"
  }
}
