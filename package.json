{
  "name": "news-digest",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages scripts",
    "boundaries": "depcruise apps/api/src --config .dependency-cruiser.cjs",
    "test": "tsx --test apps/api/test/*.test.ts",
    "check": "pnpm --filter @digest/contracts build && pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test",
    "migrate": "tsx apps/api/src/libs/db/migrate.ts",
    "evaluate:ranking": "tsx apps/api/scripts/evaluate-ranking.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.2",
    "dependency-cruiser": "^17.1.0",
    "@types/node": "^22.18.0",
    "playwright": "^1.56.1"
  }
}
